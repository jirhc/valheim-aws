# ── Valheim Server Configuration ──────────────────────────────────────────────
# Copy this file to .env and adjust the values to your liking.

# Server display name (visible in the server browser)
SERVER_NAME=MyValheimServer

# World name (also the save-file name)
WORLD_NAME=MyWorld

# Server password (minimum 5 characters, must NOT contain the server name)
SERVER_PASSWORD=changeme

# Server visibility: 1 = public (listed in browser), 0 = private
SERVER_PUBLIC=1

# ── BepInEx Mod Manager ──────────────────────────────────────────────────────
# Set to true to install and enable BepInEx mod support
BEPINEX_ENABLED=true

# BepInEx release version to install (GitHub tag without the 'v' prefix)
BEPINEX_VERSION=5.4.23.2

# ── Crossplay ─────────────────────────────────────────────────────────────────
# Set to true to enable crossplay (Steam + Xbox Game Pass)
ENABLE_CROSSPLAY=false

# ── Advanced / Paths ─────────────────────────────────────────────────────────
# Steam / Valheim user inside the container
STEAM_USER=steam

# Valheim server port (UDP) — game uses PORT, PORT+1, PORT+2
SERVER_PORT=2456
